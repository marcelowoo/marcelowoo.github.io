@article{jmp,
  abbr={jmp},
  title={Heads in the Sand: Theory and Experiment on the Interdependence of Information Avoidance},
  author = {Sonderegger, Silvia and Tufano, Fabio and Woo, Marcelo},
  abstract={
    Information avoidance in individual decision-making is well-documented: individuals often forgo useful, freely available information, even when doing so leads them to worse outcomes. Yet in many settings —-- such as global warming, infectious disease, organizational performance --— outcomes are interdependent across individuals. In this paper, we develop a theoretical framework and design a novel experiment to  study information avoidance in environments where information is freely available  and ignorance is individually and collectively harmful. In such settings, when individuals are more likely to avoid information if others do so, groups risk becoming trapped in damaging collective ignorance equilibria. Our theoretical model shows, however, that the opposite pattern may also arise: individuals may become more likely to acquire information precisely when others avoid it. Consistent with both patterns, we find substantial heterogeneity in the data. Around 20\% of subjects exhibit strategic complementarity, avoiding information when others do so, while a similar share exhibit strategic substitutability, acquiring information when others avoid it. The coexistence of these tendencies implies that group composition shapes equilibrium outcomes and can determine whether groups converge to widespread awareness or collective ignorance.
    },
  selected={true},
  type = {JMP},
  preview = {eqia_gr_nonlinearities_box2.jpg},
  pdf = {jmp.pdf}
}

@article{Ruzzier.Woo2023DiscriminationInaccurateBeliefs,
  title = {Discrimination with Inaccurate Beliefs and Confirmation Bias},
  author = {Ruzzier, Christian and Woo, Marcelo},
  year = {2023},
  month = {Jun},
  journal = {Journal of Economic Behavior \& Organization},
  volume = {210},
  pages = {379--390},
  issn = {0167-2681},
  doi = {10.1016/j.jebo.2023.04.018},
  urldate = {2024-04-23},
  abstract = {We examine patterns of discrimination when employers hold incorrect beliefs about the relationship between group membership and productivity, and suffer from confirmation bias when updating their beliefs. As a result, employers do not correct them fully, leading to persistent wage discrimination. Negative stereotypes generate discrimination against minority workers upon entry to the labor market, but are not enough to have discrimination in the long run, and reversals in discrimination are possible. We also discuss whether interventions aimed at reducing discrimination would succeed if confirmation bias is an important source of discrimination, and consider segregation in an extension with heterogeneous employers.},
  type = {publication},
  pdf = {discrimination_jebo.pdf}
}

