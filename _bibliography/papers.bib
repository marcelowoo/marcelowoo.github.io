@article{jmp,
  abbr={jmp},
  title={Contagious Ignorance: Theory and Experiment on the Interdependence of Information Avoidance},
  author = {Sonderegger, Silvia and Tufano, Fabio and Woo, Marcelo},
  abstract={We study whether the deliberate avoidance of useful and freely available information can be interdependent across people. 
    Agents derive direct utility from their beliefs about their state-dependent future consumption, potentially creating an incentive to avoid belief-inducing information. 
    Building on Bénabou (2013), our model predicts that when remaining ignorant imposes negative externalities on others' future payoffs, individuals’ decisions to acquire or avoid information may exhibit strategic complementarities (making ignorance contagious), strategic substitutabilities (making it self-limiting), or be unconditional. 
    We test these predictions in a novel experiment where participants choose whether to learn a payoff-relevant state and where remaining ignorant worsens future payoffs of all group members. 
    Consistent with contagious ignorance, exogenously increasing expectations about the prevalence of information avoidance raises participants' own propensity to avoid information.
    Evidence suggests this contagion of ignorance is mediated by a deterioration in anticipatory utility upon learning bad news, which become more severe as ignorance becomes more common. 
    Individuals differ substantially in their best-responses to others' informational choices: around 40\% of subjects condition their informational choices on those of others, split evenly between strategic complements and strategic substitutes. 
    The mixture of such types affects equilibrium share of information avoiders monotonically and nonlinearly. 
    Our findings suggest that optimal incentive schemes aiming to promote the aggregate take-up of information should account for interdependences in information decisions.},
  selected={true},
  type = {JMP},
  pdf = {jmp.pdf}
}

@article{Ruzzier.Woo2023DiscriminationInaccurateBeliefs,
  title = {Discrimination with Inaccurate Beliefs and Confirmation Bias},
  author = {Ruzzier, Christian and Woo, Marcelo},
  year = {2023},
  month = {Jun},
  journal = {Journal of Economic Behavior \& Organization},
  volume = {210},
  pages = {379--390},
  issn = {0167-2681},
  doi = {10.1016/j.jebo.2023.04.018},
  urldate = {2024-04-23},
  abstract = {We examine patterns of discrimination when employers hold incorrect beliefs about the relationship between group membership and productivity, and suffer from confirmation bias when updating their beliefs. As a result, employers do not correct them fully, leading to persistent wage discrimination. Negative stereotypes generate discrimination against minority workers upon entry to the labor market, but are not enough to have discrimination in the long run, and reversals in discrimination are possible. We also discuss whether interventions aimed at reducing discrimination would succeed if confirmation bias is an important source of discrimination, and consider segregation in an extension with heterogeneous employers.},
  type = {publication},
  pdf = {discrimination_jebo.pdf}
}

