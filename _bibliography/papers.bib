@article{jmp,
  abbr={jmp},
  title={Contagious Ignorance: Theory and Experiment on the Interdependence of Information Avoidance},
  author = {Sonderegger, Silvia and Tufano, Fabio and Woo, Marcelo},
  abstract={People often prefer not to know readily available information that could improve subsequent decisions. In organizations, resistance to information has been found to be correlated, contributing to salient losses. We study whether the deliberate avoidance of valuable and freely available information can be interdependent across people. Building on Bénabou (2013), our model predicts that when ignorance is socially harmful, individuals' willingness to decline free information may exhibit strategic complementarities (making ignorance contagious), strategic substitutabilities (making it self-limiting), or unconditional behavior. We test these predictions in a novel experiment where remaining ignorant about the state worsens future payoffs of all group members. Consistent with contagious ignorance, exogenously increasing expectations about the prevalence of information avoidance (and hence, about the severity of future payoffs) increases own's willingness to avoid information.
    Evidence suggests this contagion operates through a deterioration in anticipatory utility upon learning bad news. Beyond the average effect, individuals differ substantially: some act as strategic complements, and an equally sizable share as substitutes. Simulations show that the mixture of such types affects equilibrium avoidance monotonically and nonlinearly. 
    Our findings nuance recommendations from the literature on individual decision-making: incentivizing one individual to acquire information may strengthen or weaken others' incentives, suggesting that optimal incentive schemes should account for potential crowding-in or crowding-out of information decisions.},
  selected={true},
  type = {JMP},
  pdf = {jmp.pdf}
}

@article{Ruzzier.Woo2023DiscriminationInaccurateBeliefs,
  title = {Discrimination with Inaccurate Beliefs and Confirmation Bias},
  author = {Ruzzier, Christian and Woo, Marcelo},
  year = {2023},
  month = {Jun},
  journal = {Journal of Economic Behavior \& Organization},
  volume = {210},
  pages = {379--390},
  issn = {0167-2681},
  doi = {10.1016/j.jebo.2023.04.018},
  urldate = {2024-04-23},
  abstract = {We examine patterns of discrimination when employers hold incorrect beliefs about the relationship between group membership and productivity, and suffer from confirmation bias when updating their beliefs. As a result, employers do not correct them fully, leading to persistent wage discrimination. Negative stereotypes generate discrimination against minority workers upon entry to the labor market, but are not enough to have discrimination in the long run, and reversals in discrimination are possible. We also discuss whether interventions aimed at reducing discrimination would succeed if confirmation bias is an important source of discrimination, and consider segregation in an extension with heterogeneous employers.},
  type = {publication},
  pdf = {discrimination_jebo.pdf}
}

