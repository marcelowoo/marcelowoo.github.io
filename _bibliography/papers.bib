@article{jmp,
  abbr={jmp},
  title={Contagious Ignorance: Theory and Experiment on the Interdependence of Information Avoidance},
  author = {Sonderegger, Silvia and Tufano, Fabio and Woo, Marcelo},
  abstract={People often avoid information that could help them hold accurate beliefs and make better decisions. This paper asks whether such information avoidance can be interdependent within groups. Inspired by Benabou (2013), our theoretical model predicts that when avoidance is socially harmful, individuals' willingness to remain ignorant may exhibit strategic complementarities (making ignorance contagious), strategic substitutabilities (making it self-limiting), or unconditional behavior. We test these predictions with a novel experiment where remaining ignorant about the state worsens the future payoffs of all group members. Consistent with contagious ignorance, participants are, on average, more likely to avoid information when they expect others to do the same. Evidence suggests that the contagion is mediated by a deterioration of anticipatory utility upon learning bad news. Beyond the average effect, individuals differ: some react as strategic complements, others as substitutes, and some unconditionally acquire or avoid information. Simulations show that group composition affects the equilibrium prevalence of avoidance monotonically and nonlinearly. Our findings nuance recommendations from the literature on individual decision-making: incentivizing one individual to acquire information may strengthen or weaken others' incentives, suggesting that policies should account for potential crowding-in or crowding-out effects.},
  selected={true},
  type = {JMP},
  pdf = {groupthink.pdf}
}

@article{Ruzzier.Woo2023DiscriminationInaccurateBeliefs,
  title = {Discrimination with Inaccurate Beliefs and Confirmation Bias},
  author = {Ruzzier, Christian and Woo, Marcelo},
  year = {2023},
  month = {Jun},
  journal = {Journal of Economic Behavior \& Organization},
  volume = {210},
  pages = {379--390},
  issn = {0167-2681},
  doi = {10.1016/j.jebo.2023.04.018},
  urldate = {2024-04-23},
  abstract = {We examine patterns of discrimination when employers hold incorrect beliefs about the relationship between group membership and productivity, and suffer from confirmation bias when updating their beliefs. As a result, employers do not correct them fully, leading to persistent wage discrimination. Negative stereotypes generate discrimination against minority workers upon entry to the labor market, but are not enough to have discrimination in the long run, and reversals in discrimination are possible. We also discuss whether interventions aimed at reducing discrimination would succeed if confirmation bias is an important source of discrimination, and consider segregation in an extension with heterogeneous employers.},
  type = {publication},
  pdf = {discrimination_jebo.pdf}
}

